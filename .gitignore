# Python virtual environment (each person makes their own — don't share it)
venv/
.venv/
__pycache__/

# The YOLO base models re-download automatically — no need to store them
*.pt
# ...except our fine-tuned model — share it with the team
!vigil-phone.pt

# The saved phone photos (these are generated, not code)
alerts/

# Evidence log — the database and saved evidence photos (generated data)
evidence/
evidence.db

# Which cameras were configured (local settings, not code)
camera_config.json
cameras.json

# Per-install secret for signing login cookies (never commit)
secret.key

# Per-install Web Push signing keys + phone subscriptions (never commit)
vapid_private.pem
vapid_public.txt
push_subs.json

# Live settings saved from the in-app Settings page (per-install)
settings.json

# macOS junk
.DS_Store

# Built release zip
dist/

# Fine-tuning dataset & training outputs (big generated data, not code)
dataset/
runs/
build/

# Desktop shell: per-user stable port (runtime artifact)
.vigil-port
